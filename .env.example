# Read by docker/docker-compose.yml — mirrors backend/.env.example.
# For native (non-Docker) dev, copy backend/.env.example -> backend/.env and web/.env.example -> web/.env.local instead.

ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

METAMCP_URL=http://host.docker.internal:12008/metamcp/tapestry/mcp
METAMCP_API_KEY=

TAPESTRY_WORKSPACE_ROOT=

# Comma-separated browser origins the API accepts requests from (CORS).
# Defaults to http://localhost:3200 if unset. Add your Tailscale origin
# here to reach Tapestry from your phone, e.g.:
#   TAPESTRY_WEB_ORIGINS=http://localhost:3200,http://your-mac-name.your-tailnet.ts.net:3200
TAPESTRY_WEB_ORIGINS=
