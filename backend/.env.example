# Model providers (LiteLLM) — at least one required
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Chat surfaces
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# metamcp — Tapestry-scoped namespace/endpoint (see docs/vendor-research/ANALYSIS-metamcp.md)
METAMCP_URL=http://localhost:12008/metamcp/tapestry/mcp
METAMCP_API_KEY=

# storage
TAPESTRY_DB_PATH=./tapestry.sqlite
TAPESTRY_CHECKPOINT_PATH=./tapestry_checkpoints.sqlite

# web adapter
TAPESTRY_API_HOST=0.0.0.0
TAPESTRY_API_PORT=8420

# Comma-separated list of browser origins the API accepts requests from
# (CORS). Defaults to http://localhost:3200 if unset. Add an origin here
# to reach Tapestry from another device on the same tailnet/LAN, e.g. to
# use it from a phone over Tailscale:
#   TAPESTRY_WEB_ORIGINS=http://localhost:3200,http://your-mac-name.your-tailnet.ts.net:3200
TAPESTRY_WEB_ORIGINS=

# the git worktree Tapestry's tools operate on
TAPESTRY_WORKSPACE_ROOT=
