# The browser derives the API URL at runtime from whatever host the page
# was loaded from (localhost, a LAN IP, a Tailscale hostname), on the port
# below -- see lib/api.ts's resolveApiUrl(). No change needed to reach
# Tapestry from another device; these two vars are optional overrides.
NEXT_PUBLIC_API_PORT=8420
# NEXT_PUBLIC_API_URL=http://localhost:8420
